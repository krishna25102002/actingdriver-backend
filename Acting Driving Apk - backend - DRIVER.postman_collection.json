    {
      "name": "Cancellation / Reassignment / No-Show (TC001-TC016)",
      "item": [
        {
          "name": "Customer - preview cancellation fee",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/action/customers/bookings/{{bookingId}}/cancel/preview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "action", "customers", "bookings", "{{bookingId}}", "cancel", "preview"]
            }
          },
          "response": []
        },
        {
          "name": "Customer - cancel booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my plans\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/action/customers/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "action", "customers", "bookings", "{{bookingId}}", "cancel"]
            }
          },
          "response": []
        },
        {
          "name": "Customer - list action bookings (by status)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/action/customers/bookings?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "action", "customers", "bookings"],
              "query": [
                { "key": "status", "value": "CONFIRMED" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Customer - action booking detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/action/customers/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "action", "customers", "bookings", "{{bookingId}}"]
            }
          },
          "response": []
        },
