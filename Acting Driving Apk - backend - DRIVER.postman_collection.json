            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Scheduling conflict\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/action/drivers/booking-requests/{{requestId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "action", "drivers", "booking-requests", "{{requestId}}", "reject"]
            }
          },
          "response": []
        },
