              "path": ["api", "admin", "bookings", "{{bookingId}}", "driver-no-show"]
            }
          },
          "response": []
        },
        {
          "name": "Config - get app config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config"]
            }
          },
          "response": []
        },
        {
          "name": "Admin - update cancellation/no-show config",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationFeeFlat\": 50,\n  \"cancellationFeePercent\": 10,\n  \"cancellationFeeArrivedFlat\": 100,\n  \"cancellationFeeArrivedPercent\": 25,\n  \"noShowCustomerFeeFlat\": 100,\n  \"noShowCustomerFeePercent\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": ["{{baseUrl}}"],
